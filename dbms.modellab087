SQL> CREATE TABLE COLLEGE(
  2  COLLEGE_ID NUMBER(10) PRIMARY KEY,
  3  COLLEGE_NAME VARCHAR2(10)
  4  );

Table created.

SQL> CREATE TABLE STUDENT (
  2  STUDENT_ID NUMBER(10) PRIMARY KEY,
  3  STUDENT_NAME VARCHAR2(20) NOT NULL,
  4  EMAIL VARCHAR2(20) UNIQUE,
  5  CGPA NUMBER(3,2) CHECK (CGPA >= 0 AND CGPA <= 10),
  6  COLLEGE_ID NUMBER,
  7  FOREIGN KEY (COLLEGE_ID) REFERENCES COLLEGE(COLLEGE_ID)
  8  );

Table created.

